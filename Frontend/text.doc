  background: linear-gradient(135deg, #f7f4ff 0%, #eef2ff 100%);
}

.signup-page {
  width: min(100%, 440px);
  background: #ffffff;
  padding: 32px 28px;
  border-radius: 24px;
  box-shadow: 0 20px 45px rgba(108, 99, 255, 0.14);
  border: 1px solid rgba(108, 99, 255, 0.12);
}

.logo-section {
  text-align: center;
  margin-bottom: 18px;
}

.logo-section h2 {
  color: #6c63ff;
  font-size: 26px;
  font-weight: 700;
  margin: 0;
}

.heading-section {
  text-align: center;
  margin-bottom: 24px;
}

.heading-section h1 {
  font-size: 28px;
  color: #1f2937;
  font-weight: 700;
  margin: 0 0 8px;
}

.heading-section p {
  color: #6b7280;
  font-size: 15px;
  line-height: 1.5;
  margin: 0;
}

.signup-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.signup-form label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #374151;
}

.signup-form input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #d9dcef;
  border-radius: 12px;
  font-size: 15px;
  color: #111827;
  background-color: #ffffff;
  box-sizing: border-box;
  outline: none;
  transition: all 0.2s ease;
}

.signup-form input:focus {
  border-color: #6c63ff;
  box-shadow: 0 0 0 4px rgba(108, 99, 255, 0.16);
}

